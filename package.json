{
  "name": "bugzilla-mcp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun --filter '*' typecheck",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "check": "bunx vp check",
    "lint": "bunx vp lint",
    "fmt": "bunx vp fmt",
    "test": "bunx vp test run",
    "test:bun": "bun test",
    "verify:quint": "bunx quint run specs/write_guard.qnt --invariant=allSafetyInvariants --max-samples=2000 --max-steps=25 --verbosity=1 && bunx quint run specs/events_ingestion.qnt --invariant=allSafetyInvariants --max-samples=2000 --max-steps=25 --verbosity=1"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.33.1",
    "@types/bun": "^1.4.5",
    "fast-check": "^4.10.3",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
